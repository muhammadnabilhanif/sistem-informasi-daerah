        "@types/jest": "^29.5.12",
        "@types/node": "^20.0.0",
        "@types/nodemailer": "^8.0.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/pdfkit": "^0.17.6",
        "bcryptjs": "^3.0.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.1",
