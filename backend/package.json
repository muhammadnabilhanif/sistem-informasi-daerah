        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.22",
        "@nestjs/throttler": "^5.2.0",
        "@prisma/client": "^5.22.0",
        "@types/multer": "^2.2.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "groq-sdk": "^1.6.0",
        "helmet": "^7.0.0",
        "multer": "^2.3.0",
        "nodemailer": "^10.1.7",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
