{
    "name": "sistem-wilayah-backend",
    "version": "1.0.0",
    "description": "Backend API for Sistem Informasi Wilayah",
    "scripts": {
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "build": "tsc",
